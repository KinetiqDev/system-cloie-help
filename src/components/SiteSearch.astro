---
/**
 * The site's primary search entry.
 *
 * Starlight's `Search.astro` cannot be instantiated twice on a page: each copy
 * renders `<div id="starlight__search">`, and Pagefind mounts with
 * `querySelector('#starlight__search')`, so only the first instance ever
 * receives the search UI. The header already ships that working instance, so
 * this block is a labelled input that opens it and hands over the query
 * instead of embedding a second, permanently empty dialog.
 *
 * The magnifier path is copied from Starlight's own icon so both search
 * affordances on this page are the same mark at the same weight.
 */
const magnifier =
  '<path d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z"/>';
---

<div class="site-search">
  <label class="site-search__label" for="site-search-input">Search this Help Center</label>
  <div class="site-search__field">
    <svg
      class="site-search__icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      set:html={magnifier}
    />
    <input
      id="site-search-input"
      class="site-search__input"
      type="search"
      name="q"
      placeholder="What are you trying to do?"
      autocomplete="off"
      enterkeyhint="search"
      aria-describedby="site-search-hint"
    />
    <kbd class="site-search__kbd" aria-hidden="true">Ctrl K</kbd>
  </div>
  <p class="site-search__hint" id="site-search-hint">
    Search by what you are trying to do — “publish evaluation”, “missing course”, “can't submit”.
  </p>
</div>

<script>
  const input = document.getElementById('site-search-input') as HTMLInputElement | null;

  // The header's control is the one working search instance; open it and pass
  // the typed query along, so nobody retypes what they already entered.
  const openHeaderSearch = () => {
    if (!input) return;
    const trigger = document.querySelector<HTMLButtonElement>('header button[data-open-modal]');
    if (!trigger) return;
    trigger.click();

    // Pagefind's input mounts with the dialog; wait a frame for it if the
    // dialog has not rendered its input yet.
    const target = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
    if (target) {
      target.value = input.value.trim();
      target.dispatchEvent(new Event('input', { bubbles: true }));
      target.focus();
      return;
    }
    const observer = new MutationObserver(() => {
      const found = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
      if (!found) return;
      observer.disconnect();
      found.value = input.value.trim();
      found.dispatchEvent(new Event('input', { bubbles: true }));
      found.focus();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  };

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      openHeaderSearch();
    }
  });

  // Clicking the icon or the field's padding opens search too; a bare
  // `<input>` would leave that area inert.
  const field = document.querySelector('.site-search__field');
  field?.addEventListener('click', (event) => {
    if (event.target === input || !input) return;
    input.focus();
  });
</script>

<style>
  .site-search {
    margin: var(--space-6) 0;
  }

  .site-search__label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .site-search__field {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background-color: var(--surface-input);
    cursor: text;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .site-search__field:hover {
    border-color: var(--border-strong);
  }

  /* The whole field reads as one control, so the ring is drawn around the
     field rather than around the input alone. */
  .site-search__field:focus-within {
    border-color: var(--focus-ring);
    box-shadow: 0 0 0 3px var(--primary-wash-muted);
  }

  .site-search__icon {
    flex: none;
    color: var(--link-color);
  }

  .site-search__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) 0;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    font-size: var(--font-size-body-sm);
  }

  .site-search__input:focus {
    outline: none;
  }

  .site-search__input::placeholder {
    color: var(--text-muted);
  }

  /* WebKit's native clear button is a default that belongs to no design
     system, so it is suppressed rather than shipped unstyled. */
  .site-search__input::-webkit-search-cancel-button {
    appearance: none;
  }

  .site-search__kbd {
    flex: none;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xs);
    background-color: var(--surface-muted);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .site-search__hint {
    margin-top: var(--space-2);
    font-size: var(--font-size-caption);
    color: var(--text-muted);
  }

  @media (max-width: 30em) {
    .site-search__kbd {
      display: none;
    }
  }
</style>
